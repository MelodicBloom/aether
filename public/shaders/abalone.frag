precision highp float;
uniform float u_time; uniform vec2 u_res; uniform float u_speed; uniform float u_intensity; uniform float u_scale; uniform float u_family; uniform float u_structure; uniform float u_spectral; uniform float u_edge; uniform float u_flow; uniform float u_depth;
#define PI 3.14159265359
#define TAU 6.28318530718
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}
float noise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),f.x),f.y);}
float fbm(vec2 p){float v=0.,a=.5;mat2 r=mat2(.877,.479,-.479,.877);for(int i=0;i<5;i++){v+=a*noise(p);p=r*p*2.03;a*=.5;}return v;}
vec3 spectrum(float x){return .55+.45*cos(TAU*(x+vec3(0.,.33,.67)));}
mat2 rot(float a){float c=cos(a),s=sin(a);return mat2(c,-s,s,c);}

vec3 thinFilm(vec2 uv,float t){vec2 q=rot(.18*sin(t*.4))*uv;float n1=fbm(q*2.1+vec2(t*.34,-t*.22));float n2=fbm(q*4.2+vec2(-t*.18,t*.29));float membrane=sin((q.x+n1*.52)*8.5+t*1.3)+cos((q.y-n2*.4)*7.2-t*.9);float phase=membrane*.16+n1*.72+n2*.28+t*.12;vec3 sp=spectrum(phase*1.35);float caust=pow(.5+.5*sin((n1-n2)*18.+t*2.1),5.);float edge=pow(clamp(1.-length(q)*.68,0.,1.),.35);return mix(vec3(.015,.025,.07),sp,.76*u_spectral)*(edge+.42)+sp*caust*.7+vec3(.3,.75,1.)*pow(max(0.,sin(phase*22.)),12.)*.22;}
vec3 shell(vec2 uv,float t){vec2 q=uv+.07*vec2(sin(t*.55),cos(t*.43));vec2 w=vec2(fbm(q*1.4+vec2(t*.72,1.7)),fbm(q*1.7+vec2(4.2,-t*.58)));float rid=sin((q.x+w.x*.95)*13.+(q.y+w.y)*4.5+t*1.1);float d=fbm(q*2.8+w*1.7+vec2(t*.22,-t*.16));float ph=d*2.4+rid*.18+t*.62;vec3 p=vec3(.62,.74,.78)+.34*cos(TAU*(ph+vec3(.02,.24,.49)));float hi=pow(clamp(d+rid*.14,0.,1.),5.);return mix(vec3(.12,.06,.16),p,.72+.25*u_spectral)*(.72+d*.65)+vec3(1.,.92,.78)*hi*.8;}
vec3 aurora(vec2 uv,float t){vec2 q=uv;q.y+=t*.22*u_flow;q.x+=sin(q.y*1.8+t*1.15)*.28;float a=exp(-8.*abs(q.x+.32*sin(q.y*1.3+t*.9)));float b=exp(-10.*abs(q.x-.42*cos(q.y*1.1-t*.78)));float h=fbm(vec2(q.x*1.2+t*.18,q.y*2.5-t*.95));return vec3(.008,.018,.075)+vec3(.02,.95,.82)*a*(.38+.62*h)+mix(vec3(.46,.16,.95),vec3(.28,1.,.48),h)*b*.82+vec3(.04,.08,.22)*h;}
vec3 fresnel(vec2 uv,float t){vec2 tilt=vec2(.32*sin(t*.72),.24*cos(t*.57));vec2 q=rot(.18*sin(t*.41))*(uv-tilt*.28);float z=sqrt(max(.001,1.-min(1.,dot(q,q)*.72)));vec3 n=normalize(vec3(q+tilt,z));vec3 v=normalize(vec3(-tilt*.7,1.8));float fr=pow(1.-max(0.,dot(n,v)),2.2+u_edge*3.8);float aperture=abs(length(q)-(.58+.09*sin(t*1.1)));float ring=exp(-42.*aperture);float iris=.5+.5*cos(atan(q.y,q.x)*12.+t*1.8+fbm(q*3.)*2.);vec3 rim=spectrum(atan(q.y,q.x)/TAU+t*.08)*fr*(1.2+u_spectral);vec3 lens=vec3(.008,.014,.04)+vec3(.03,.16,.22)*z;return lens+rim+ring*mix(vec3(.1,.8,1.),vec3(1.,.15,.75),iris)*1.4+pow(z,18.)*vec3(.5,.8,1.)*.35;}
vec3 holo(vec2 uv,float t){vec2 a=rot(.12*sin(t*.8))*uv,b=rot(-.17*cos(t*.63))*uv;float l1=.5+.5*sin(a.x*34.+a.y*6.-t*6.);float l2=.5+.5*sin(b.x*29.-b.y*8.+t*5.2);float moire=pow(abs(l1-l2),.42);float scan=.5+.5*sin((uv.x+uv.y)*12.-t*9.);float micro=step(.84,hash(floor((uv+t*.08)*180.)));vec3 sp=spectrum(uv.x*.56+uv.y*.32+moire*.72+t*.18);return vec3(.012,.018,.055)+sp*(.18+moire*.9+scan*.22)+micro*sp*1.6;}
vec3 metal(vec2 uv,float t){vec2 w=vec2(fbm(uv*1.8+vec2(t*.42,0.)),fbm(uv*1.8+vec2(3.,-t*.35)));float f=sin((uv.x+w.x)*7.+t)+cos((uv.y+w.y)*6.-t*.8);float hi=pow(clamp(.5+.25*f,0.,1.),6.);vec3 steel=mix(vec3(.025,.03,.04),vec3(.75,.82,.9),smoothstep(-.5,.8,f));return steel*(.45+u_depth*.55)+hi*vec3(1.,.9,.72);}
vec3 velvet(vec2 uv,float t){vec2 q=uv;float warp=fbm(vec2(q.y*3.2-t*.42,q.x*2.4+t*.27));q.x+=(warp-.5)*.12;float ang=.22*sin(t*.7);vec2 d=vec2(cos(ang),sin(ang));float fibers=.5+.5*sin(dot(q,d)*132.+fbm(q*5.+t*.1)*10.);float nap=pow(abs(dot(d,normalize(q+vec2(.001)))),2.);vec3 base=mix(vec3(.018,.004,.035),vec3(.48,.018,.32),nap);float glitch=smoothstep(.72,.98,noise(vec2(floor(q.y*14.-t*2.),floor(t*1.7))));vec2 shift=vec2(.012+.045*glitch,0.);float r=fbm((q+shift)*3.4+t*.08),g=fbm(q*3.4-t*.04),b=fbm((q-shift)*3.4+t*.03);vec3 aberr=vec3(r,g,b)-vec3(g);float melt=pow(.5+.5*sin((q.y+warp*.3)*18.-t*3.4),8.)*glitch;return base+vec3(.5,.12,.58)*fibers*.15*u_structure+aberr*1.15+mix(vec3(.1,.5,1.),vec3(1.,.08,.55),warp)*melt*.65;}
vec3 crystal(vec2 uv,float t){vec2 q=rot(t*.22)*uv*3.2;q+=.08*vec2(sin(t*.9+q.y),cos(t*.7+q.x));vec2 cell=floor(q),f=fract(q)-.5;float id=hash(cell);vec2 axis=vec2(cos(id*TAU+t*.9),sin(id*TAU+t*.9));float facet=abs(dot(f,axis));float bevel=1.-smoothstep(.3,.49,max(abs(f.x),abs(f.y)));float refr=fbm(q*.8+axis*t*.42);vec3 pr=spectrum(id+t*.24+facet*.8+refr*.3);float pulse=.6+.4*sin(t*2.8+id*TAU);return mix(vec3(.01,.035,.08),pr,.42+u_spectral*.42)*(1.-facet*.3)+pr*bevel*(.45+.55*pulse)*u_edge;}
vec3 ionBloom(vec2 uv,float t){vec2 q=uv;float d=10.;for(int i=0;i<5;i++){float fi=float(i);q=abs(q)/clamp(dot(q,q),.22,2.4)-vec2(.72+.08*sin(t+fi),.48+.06*cos(t*.8+fi));d=min(d,length(q)*pow(.62,fi));}float core=exp(-18.*d);float halo=exp(-4.*d);return vec3(.01,.005,.05)+spectrum(d*2.-t*.18)*core*2.4+vec3(.15,.25,1.)*halo*.8;}
vec3 opal(vec2 uv,float t){vec2 q=rot(.08*sin(t*.5))*uv;float lens=sqrt(max(.001,1.-min(1.,dot(q,q)*.58)));float n=fbm(q*2.2+vec2(t*.22,-t*.16));float c1=pow(.5+.5*sin((q.x+n*.5)*9.+t*1.8),6.);float c2=pow(.5+.5*cos((q.y-n*.4)*11.-t*1.4),7.);float bubbles=smoothstep(.94,1.,noise(floor((q+t*.03)*18.)));vec3 milk=mix(vec3(.045,.09,.13),vec3(.72,.82,.78),lens*.72);vec3 ir=spectrum(n*.8+t*.06)*(.22+.52*(c1+c2));return milk*.72+ir+bubbles*vec3(.9,.8,1.)*.5+pow(lens,24.)*vec3(.8,.95,1.)*.7;}
vec3 magnetic(vec2 uv,float t){vec2 m=.34*vec2(sin(t*.72),cos(t*.57));vec2 d=uv-m;float r=max(length(d),.04);float a=atan(d.y,d.x);float base=.5+.5*sin(a*18.-2.2/r+t*1.3+fbm(uv*2.8)*3.);float filament=pow(base,15.)*exp(-.72*r);float secondary=pow(.5+.5*sin(a*31.+1.35/r-t*.8),22.)*exp(-1.05*r);float select=step(.86,noise(floor(vec2(a*8.,r*24.))));vec3 ink=vec3(.012,.006,.025)+vec3(.11,.025,.16)*filament*1.9+vec3(.025,.13,.18)*secondary*.75;ink+=spectrum(a/TAU+t*.025)*filament*select*.34;return ink;}
vec3 mesh(vec2 uv,float t){vec2 q=uv*3.2;vec3 col=vec3(.004,.008,.032);for(int i=0;i<6;i++){float fi=float(i);float y=-1.1+fi*.44+.08*sin(t*1.4+fi);float curve=y+.12*sin(q.x*1.7+fi*1.9+t*(1.1+fi*.06));float line=exp(-48.*abs(q.y-curve));float packet=pow(.5+.5*sin(q.x*4.2-t*(9.+fi)+fi*2.4),18.);vec3 c=spectrum(fi*.13+t*.08+q.x*.04);col+=c*line*(.18+1.65*packet);}for(int j=0;j<5;j++){float fj=float(j);float x=-1.3+fj*.65+.09*cos(t*1.2+fj);float guide=exp(-58.*abs(q.x-x-.08*sin(q.y*2.+t*1.7+fj)));float junction=pow(.5+.5*sin(q.y*4.6+t*(7.5+fj)),22.);col+=spectrum(.15*fj-t*.06)*guide*(.12+junction*1.4);}return col;}
vec3 quantumKnot(vec2 uv,float t){float cycle=mod(t,8.);float spread=smoothstep(2.3,3.4,cycle)*(1.-smoothstep(5.4,6.8,cycle));float cells=mix(1.,3.4,spread);vec2 q=fract((uv+1.)*.5*cells)*2.-1.;q/=max(cells*.42,1.);q=rot(t*.16)*q;vec3 col=vec3(.004,.008,.03);for(int i=0;i<3;i++){float fi=float(i);float a=atan(q.y,q.x)+t*.24+fi*2.094;float r=.54+.15*cos(3.*a+t*.72);vec2 p=vec2(cos(a),sin(a))*r;float d=length(q-p);float glow=exp(-42.*d)+.35*exp(-11.*d);col+=spectrum(a/TAU+fi*.18+t*.04)*glow*(1.1+.35*sin(a*5.-t*1.8));}float kale=.5+.5*cos(atan(uv.y,uv.x)*8.+t*.8);col+=spectrum(kale+t*.03)*spread*exp(-5.*abs(length(uv)-.72))*.45;return col;}
vec3 waveFn(vec2 uv,float t){float r=length(uv),a=atan(uv.y,uv.x);float psi=sin(5.*a+t*1.7)*exp(-1.8*r)*cos(r*12.-t*2.4);float node=abs(psi);float collapse=exp(-18.*length(uv-.28*vec2(sin(t*.7),cos(t*.9))));return vec3(.004,.006,.03)+spectrum(a/TAU+t*.08)*node*1.45+vec3(1.,.25,.85)*collapse*.9;}
vec3 lorenz(vec2 uv,float t){vec3 col=vec3(.003,.006,.025);for(int i=0;i<42;i++){float fi=float(i);float a=t*.18+fi*.11;vec2 c=.44*vec2(sin(a)*cos(a*.63),sin(a*1.37));float d=length(uv-c);col+=spectrum(fi*.027+t*.04)*exp(-75.*d)*.12;}return col;}
vec3 turing(vec2 uv,float t){float a=fbm(uv*3.+t*.08),b=fbm(uv*6.-t*.11);float pat=sin((a-b)*18.+t*.7);float cell=smoothstep(-.2,.55,pat);return mix(vec3(.015,.025,.08),spectrum(a*.8+t*.04),cell)*(.7+.5*b);}
vec3 phyllo(vec2 uv,float t){vec2 q=rot(-t*.11)*uv*.82;float breath=1.+.06*sin(t*1.5);q*=breath;vec3 col=vec3(.004,.009,.025);float golden=2.39996323;for(int i=0;i<72;i++){float fi=float(i);float r=.07*sqrt(fi);float wind=.22*sin(r*5.-t*.9);float a=fi*golden+t*.12+wind;vec2 p=r*vec2(cos(a),sin(a));p*=1.+.12*sin(t*.7+fi*.17);float d=length(q-p);float seed=exp(-520.*d*d);float edge=exp(-95.*abs(d-.022-.005*sin(t*2.+fi)));vec3 c=spectrum(fi*.031+t*.04+r*.2);col+=c*(seed*.62+edge*1.25);}return col;}
vec3 mycelium(vec2 uv,float t){vec2 q=uv*1.25;vec3 col=vec3(.003,.009,.018);for(int i=0;i<8;i++){float fi=float(i);vec2 p=q;float ang=fi*.785+.22*sin(t*.35+fi);p=rot(ang)*p;p.x+=.12*sin(p.y*3.4+t*(.45+fi*.03)+fi);float lane=exp(-42.*abs(p.x-.18*sin(p.y*2.2+fi)));float pulse=pow(.5+.5*sin(p.y*8.-t*(3.8+fi*.18)+fi),10.);vec3 c=mix(vec3(.08,.9,.46),vec3(.72,.18,1.),.5+.5*sin(fi+t*.2));col+=c*lane*(.13+.85*pulse);}float node=pow(.5+.5*sin(fbm(q*3.+t*.08)*24.-t*2.4),16.);col+=spectrum(fbm(q*2.)+t*.04)*node*.45;return col;}
vec3 plasmaRosette(vec2 uv,float t){vec2 q=uv;float acc=0.;for(int i=0;i<7;i++){float fi=float(i);q=abs(q);q=rot(.52+.08*sin(t*.55+fi))*q;q=q/clamp(dot(q,q),.18,2.2)-vec2(.62+.05*sin(t+fi),.34+.04*cos(t*.8+fi));acc+=exp(-10.*length(q))*.22;}float petals=.5+.5*cos(atan(uv.y,uv.x)*10.-t*1.6);float bloom=exp(-2.8*length(uv))*(.35+.65*petals);return vec3(.006,.004,.035)+spectrum(acc*2.+t*.05)*acc*1.8+mix(vec3(.2,.8,1.),vec3(1.,.18,.72),petals)*bloom*.55;}

void main(){vec2 res=max(u_res,vec2(1.));vec2 uv=gl_FragCoord.xy/res*2.-1.;uv.x*=res.x/res.y;uv*=u_scale;float t=u_time*max(u_speed,.01)*4.5;vec3 col;if(u_family<.5)col=thinFilm(uv,t);else if(u_family<1.5)col=shell(uv,t);else if(u_family<2.5)col=aurora(uv,t);else if(u_family<3.5)col=fresnel(uv,t);else if(u_family<4.5)col=holo(uv,t);else if(u_family<5.5)col=metal(uv,t);else if(u_family<6.5)col=velvet(uv,t);else if(u_family<7.5)col=crystal(uv,t);else if(u_family<8.5)col=ionBloom(uv,t);else if(u_family<9.5)col=opal(uv,t);else if(u_family<10.5)col=magnetic(uv,t);else if(u_family<11.5)col=mesh(uv,t);else if(u_family<12.5)col=quantumKnot(uv,t);else if(u_family<13.5)col=waveFn(uv,t);else if(u_family<14.5)col=lorenz(uv,t);else if(u_family<15.5)col=turing(uv,t);else if(u_family<16.5)col=phyllo(uv,t);else if(u_family<17.5)col=mycelium(uv,t);else col=plasmaRosette(uv,t);float grain=(hash(gl_FragCoord.xy+floor(u_time*18.))-.5)*.014*u_structure;col+=grain;col*=max(u_intensity,.01)*1.32;col=col/(1.+col);col=pow(max(col,vec3(0.)),vec3(.82));gl_FragColor=vec4(col,1.);}